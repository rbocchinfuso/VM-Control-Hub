# vCenter Manager — Environment Configuration
# Copy this file to .env and fill in your values

# Flask secret key — change this to a long random string in production!
SECRET_KEY=your-very-long-random-secret-key-here

# Database URL (SQLite for simple deployments, PostgreSQL for production)
DATABASE_URL=sqlite:///vcenter_manager.db
# For PostgreSQL:
# DATABASE_URL=postgresql://vcenter:yourpassword@db:5432/vcenter_manager

# Default admin account (created on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Gunicorn workers (for docker-compose production deploy)
WORKERS=4
